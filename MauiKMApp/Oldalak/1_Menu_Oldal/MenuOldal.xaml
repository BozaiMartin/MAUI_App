<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="KmKiolvasasMaui.MenuOldal"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Menü">

    <VerticalStackLayout
        Padding="30"
        Spacing="20"
        VerticalOptions="Center">

        <Label
            Text="Menü"
            FontSize="24"
            HorizontalOptions="Center" />

        <Button
            Text="Beolvasás"
            Clicked="NavigalMainPage"
            HorizontalOptions="Fill" />

        <Button
            Text="Email küldés"
            Clicked="NavigalEmailOldal"
            HorizontalOptions="Fill" />

        <Button
            Text="Mentett adatok"
            Clicked="NavigalAdatokOldal"
            HorizontalOptions="Fill" />

        <Button
            Text="Jelszó módosítása"
            Clicked="NavigalJelszoCsereOldal"
            HorizontalOptions="Fill" />

        <Button
            Text="Kijelentkezés"
            Clicked="Kijelentkezes_Clicked"
            HorizontalOptions="Fill" />

    </VerticalStackLayout>

</ContentPage>