<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="KmKiolvasasMaui.JelszoCsereOldal"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Jelszó módosítása">

    <ScrollView>

        <VerticalStackLayout
            Padding="30"
            Spacing="20"
            VerticalOptions="Center">

            <Label
                x:Name="CimLabel"
                Text="Jelszó módosítása"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Entry
                x:Name="RegiJelszoEntry"
                Placeholder="Jelenlegi jelszó"
                IsPassword="True" />

            <Entry
                x:Name="UjJelszoEntry"
                Placeholder="Új jelszó"
                IsPassword="True" />

            <Entry
                x:Name="UjJelszoUjraEntry"
                Placeholder="Új jelszó újra"
                IsPassword="True"
                ReturnType="Done"
                Completed="UjJelszoUjraEntry_Completed" />
            
            <HorizontalStackLayout Spacing="10">

                <CheckBox
                    x:Name="JelszoMegjelenitesCheckBox"
                    CheckedChanged="JelszoMegjelenitesCheckBox_CheckedChanged" />

                <Label
                    Text="Jelszavak megjelenítése"
                    VerticalOptions="Center" />

            </HorizontalStackLayout>

            <Button
                x:Name="MentesButton"
                Text="Jelszó módosítása"
                Clicked="MentesButton_Clicked" />

            <ActivityIndicator
                x:Name="BetoltesIndicator"
                IsVisible="False"
                IsRunning="False"
                HorizontalOptions="Center" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>