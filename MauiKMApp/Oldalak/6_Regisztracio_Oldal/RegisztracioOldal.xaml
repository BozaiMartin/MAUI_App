<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="KmKiolvasasMaui.RegisztracioOldal"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Regisztráció">

    <ScrollView>

        <VerticalStackLayout
            Padding="30"
            Spacing="20">

            <Label
                Text="Első regisztráció"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Button
                Text="Regisztrációs QR beolvasása"
                Clicked="QrBeolvasasButton_Clicked" />

            <VerticalStackLayout
                x:Name="AdatokLayout"
                Spacing="10"
                IsVisible="False">

                <Label
                    x:Name="DolgozoNevLabel"
                    FontSize="18"
                    FontAttributes="Bold" />

                <Label
                    x:Name="DolgozoSzamLabel" />

                <Label
                    x:Name="SzervezetLabel" />

                <Label
                    x:Name="TelephelyLabel" />

            </VerticalStackLayout>

            <Entry
                x:Name="UjJelszoEntry"
                Placeholder="Jelszó"
                IsPassword="True" />

            <Entry
                x:Name="UjJelszoUjraEntry"
                Placeholder="Jelszó újra"
                IsPassword="True" />

            <HorizontalStackLayout Spacing="10">

                <CheckBox
                    CheckedChanged="JelszoMegjelenitesCheckBox_CheckedChanged" />

                <Label
                    Text="Jelszavak megjelenítése"
                    VerticalOptions="Center" />

            </HorizontalStackLayout>

            <Button
                x:Name="RegisztracioButton"
                Text="Regisztráció"
                IsEnabled="False"
                Clicked="RegisztracioButton_Clicked" />

            <ActivityIndicator
                x:Name="BetoltesIndicator"
                IsVisible="False"
                IsRunning="False"
                HorizontalOptions="Center" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>