<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KmKiolvasasMaui.EmailOldal"
             Title="Email küldés">

    <VerticalStackLayout Padding="20" Spacing="15">
        <Button Text="Email tartalom" Clicked="MutatIdeiglenes_Clicked"/>
        <Button Text="Adatok elküldése emailben" Clicked="Kuldes_Clicked"/>
        <Button
    Text="Adatbázis ürítése"
    x:Name="UritesBtn"
    Clicked="Urites_Clicked"
    BackgroundColor="DarkRed"
    TextColor="White"
    CornerRadius="10"
    HorizontalOptions="Fill"
    SemanticProperties.Hint="Törli az összes adatot az adatbázisból." />
    </VerticalStackLayout>
</ContentPage>

