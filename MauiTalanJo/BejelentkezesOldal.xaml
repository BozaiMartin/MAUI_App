<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KmKiolvasasMaui.BejelentkezesOldal"
             Title="Bejelentkezés">

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">
        <Label 
            Text="Jelentkezzen be."
            FontSize="24"
            HorizontalOptions="Center" />

        <Button 
            Text="Beolvasás oldal"
            Clicked="NavigalMainPage"
            HorizontalOptions="Fill" />

        <Button 
            Text="Email küldés oldal"
            Clicked="NavigalEmailOldal"
            HorizontalOptions="Fill" />
        <Button 
    Text="Mentett adatok"
    Clicked="NavigalAdatokOldal"
    HorizontalOptions="Fill" />
    </VerticalStackLayout>
</ContentPage>
