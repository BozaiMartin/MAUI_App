<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="KmKiolvasasMaui.CameraPage"
             BackgroundColor="Black"
             Title="Automatikus Fotó">

    <Grid RowDefinitions="Auto,*" Padding="0" Margin="0">

        <!-- Kamera majdnem teljes képernyőn -->
        <toolkit:CameraView 
    x:Name="cameraView"
    Grid.Row="1"
    HorizontalOptions="FillAndExpand"
    VerticalOptions="FillAndExpand"
    MediaCaptured="CameraView_MediaCaptured"
    Margin="0"
/>

        <!-- Felül opcionálisan egy kis overlay, ha később visszajelzést akarsz -->
        <!--<Label Text="Kép készül..." 
               BackgroundColor="#80000000"
               TextColor="White"
               FontSize="20"
               HorizontalOptions="Center"
               VerticalOptions="Start"
               Margin="0"
               Padding="10"
               IsVisible="False"
               x:Name="statusLabel"/>-->

    </Grid>
</ContentPage>
