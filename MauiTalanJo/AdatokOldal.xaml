<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KmKiolvasasMaui.AdatokOldal"
             Title="Mentett adatok">

    <CollectionView x:Name="AdatokLista">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame BorderColor="LightGray" Margin="5" Padding="10">
                    <VerticalStackLayout>
                        <Label Text="{Binding Datum, StringFormat='Dátum: {0:yyyy.MM.dd}'}"
                               FontAttributes="Bold" />
                        <Label Text="{Binding Palyaszam, StringFormat='Pályaszám: {0}'}" />
                        <Label Text="{Binding Napi_km, StringFormat='Napi km: {0}'}" />
                        <Label Text="{Binding Ossz_km, StringFormat='Összes km: {0}'}" />
                        <Label Text="{Binding Email_kuldve, StringFormat='Email küldve: {0}'}" />
                    </VerticalStackLayout>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>
